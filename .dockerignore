# Keep the build context minimal: a small context means faster uploads and
# fewer spurious cache invalidations. Anything not needed to *run* the app
# inside a Linux container belongs here.

# --- Version control ---------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- Python artefacts --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ----------------------------------------------------
# The host .venv is Windows-specific; letting it into the image would shadow
# the Linux environment built by uv.
.venv/
venv/
env/

# --- Secrets and local state -------------------------------------------------
# Signing keys are mounted from the secret store at runtime. An image is pulled,
# cached and shared far more widely than a secret ever should be, so no key
# material may enter the build context -- not even by accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.pfx
secrets/
*.sqlite3
*.log

# --- Compose / tooling (never read from inside the image) --------------------
docker-compose*.yml
.dockerignore
.pre-commit-config.yaml
.claude/

# --- Editors and OS cruft ----------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Docs --------------------------------------------------------------------
docs/
*.md
!README.md
