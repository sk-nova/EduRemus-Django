# Copy to .env and fill in. Never commit .env.
# Settings read these through python-decouple, which prefers real environment
# variables over the file — that is how Compose injects container-specific
# values without editing anything here.

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=""

ENABLE_DEBUG_TOOLBAR="True"

# Comma-separated. Tenants are addressed by hostname, so every hostname that
# should reach the app must be listed. A leading dot matches all subdomains,
# which is what lets new tenants work without editing this.
DJANGO_ALLOWED_HOSTS="localhost,.localhost,127.0.0.1"

# --- Multi-tenancy -----------------------------------------------------------
# Hostname registered for the public tenant when the local stack first boots.
# Everything else -- the platform admin, the tenant catalogue -- is served here.
# Institution subdomains are added later with `manage.py tenant_create`.
PUBLIC_TENANT_DOMAIN="public.localhost"

# --- Postgres ----------------------------------------------------------------
# Consumed by the `db` service on first boot, and used by Compose to assemble
# the DATABASE_URL handed to the django container.
POSTGRES_DB="eduremus_db"
POSTGRES_USER="root"
POSTGRES_PASSWORD="password"
# Host-side port for the db container; change if 5432 is already taken locally.
POSTGRES_PORT=5432

# --- Database ----------------------------------------------------------------
# Used only when running manage.py on the host, outside Compose. Inside the
# stack this is overridden to reach the db service by name.
# This example URL works only in local environment
DATABASE_URL="postgres://root:password@127.0.0.1:5432/eduremus_db"

# --- JWT ---------------------------------------------------------------------
# Directory holding <kid>.private.pem, <kid>.public.pem and <kid>.json. Mounted
# from a secret store in production; never committed, never baked into an image.
JWT_KEY_DIRECTORY="/run/secrets/jwt"

# Key id that signs new tokens. Every key in the directory still *verifies*,
# which is what makes an overlapping rotation possible. Leave blank until the
# first key has been generated with `manage.py rotate_jwt_keys`.
JWT_ACTIVE_KEY_ID=""

# Both are verified on every token. Changing either invalidates every token
# already issued, so treat them as fixed once traffic exists.
JWT_ISSUER="https://auth.eduremus.com"
JWT_AUDIENCE="eduremus-api"

# --- Redis -------------------------------------------------------------------
# Cache, denylist, throttle and lockout counters. Inside the stack this is
# overridden to reach the redis service by name.
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_MAX_CONNECTIONS=50

# --- CORS --------------------------------------------------------------------
# MUST be anchored at both ends: an unanchored pattern also matches
# https://acme.eduremus.com.attacker.example. The localhost form below is for
# development; production uses ^https://[a-z0-9-]+\.eduremus\.com$
CORS_ALLOWED_ORIGIN_REGEX="^http://[a-z0-9-]+\.localhost:\d+$"
