# Copy to .env and fill in. Never commit .env.
# Settings read these through python-decouple, which prefers real environment
# variables over the file — that is how Compose injects container-specific
# values without editing anything here.

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=""

ENABLE_DEBUG_TOOLBAR="True"

# Comma-separated. Tenants are addressed by hostname, so every hostname that
# should reach the app must be listed. A leading dot matches all subdomains,
# which is what lets new tenants work without editing this.
DJANGO_ALLOWED_HOSTS="localhost,.localhost,127.0.0.1"

# --- Multi-tenancy -----------------------------------------------------------
# Hostname registered for the public tenant when the local stack first boots.
# Everything else -- the platform admin, the tenant catalogue -- is served here.
# Institution subdomains are added later with `manage.py tenant_create`.
PUBLIC_TENANT_DOMAIN="public.localhost"

# --- Postgres ----------------------------------------------------------------
# Consumed by the `db` service on first boot, and used by Compose to assemble
# the DATABASE_URL handed to the django container.
POSTGRES_DB="eduremus_db"
POSTGRES_USER="root"
POSTGRES_PASSWORD="password"
# Host-side port for the db container; change if 5432 is already taken locally.
POSTGRES_PORT=5432

# --- Database ----------------------------------------------------------------
# Used only when running manage.py on the host, outside Compose. Inside the
# stack this is overridden to reach the db service by name.
# This example URL works only in local environment
DATABASE_URL="postgres://root:password@127.0.0.1:5432/eduremus_db"
